terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.0"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
}

# -------------------------------------------------------------------
# Variables
# -------------------------------------------------------------------
variable "aws_region" {
  default = "us-east-1"
}

variable "db_username" {
  default = "admin"
}

variable "ssh_allowed_cidr" {
  description = "CIDR block allowed to SSH into the runner instance. Restrict this to your own IP (x.x.x.x/32)."
  default     = "0.0.0.0/0"
}

# -------------------------------------------------------------------
# Networking (single VPC so the runner and RDS can talk privately)
# -------------------------------------------------------------------
resource "aws_vpc" "main" {
  cidr_block           = "10.0.0.0/16"
  enable_dns_support   = true
  enable_dns_hostnames = true
  tags                 = { Name = "sql-runner-vpc" }
}

resource "aws_internet_gateway" "igw" {
  vpc_id = aws_vpc.main.id
}

resource "aws_subnet" "public" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = "10.0.1.0/24"
  availability_zone       = "${var.aws_region}a"
  map_public_ip_on_launch = true
  tags                    = { Name = "public-subnet" }
}

resource "aws_subnet" "private_a" {
  vpc_id            = aws_vpc.main.id
  cidr_block        = "10.0.2.0/24"
  availability_zone = "${var.aws_region}a"
  tags              = { Name = "private-subnet-a" }
}

resource "aws_subnet" "private_b" {
  vpc_id            = aws_vpc.main.id
  cidr_block        = "10.0.3.0/24"
  availability_zone = "${var.aws_region}b"
  tags              = { Name = "private-subnet-b" }
}

resource "aws_route_table" "public" {
  vpc_id = aws_vpc.main.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.igw.id
  }
}

resource "aws_route_table_association" "public" {
  subnet_id      = aws_subnet.public.id
  route_table_id = aws_route_table.public.id
}

resource "aws_db_subnet_group" "rds" {
  name       = "rds-subnet-group"
  subnet_ids = [aws_subnet.private_a.id, aws_subnet.private_b.id]
}

# -------------------------------------------------------------------
# SSH key pair — generated by Terraform, not a pre-existing PEM
# -------------------------------------------------------------------
resource "tls_private_key" "runner_key" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "aws_key_pair" "runner_key" {
  key_name   = "sql-runner-key"
  public_key = tls_private_key.runner_key.public_key_openssh
}

# Writes the private key to disk locally (0600 perms) so you can SSH in
# manually if needed. Treated as sensitive so it won't print in plan/apply output.
resource "local_sensitive_file" "private_key_pem" {
  content         = tls_private_key.runner_key.private_key_pem
  filename        = "${path.module}/sql-runner-key.pem"
  file_permission = "0600"
}

# -------------------------------------------------------------------
# Security groups
# -------------------------------------------------------------------
resource "aws_security_group" "runner_sg" {
  name_prefix = "sql-runner-sg-"
  vpc_id      = aws_vpc.main.id

  ingress {
    description = "SSH"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.ssh_allowed_cidr]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_security_group" "rds_sg" {
  name_prefix = "rds-sg-"
  vpc_id      = aws_vpc.main.id

  ingress {
    description     = "MySQL, only from the runner instance SG"
    from_port       = 3306
    to_port         = 3306
    protocol        = "tcp"
    security_groups = [aws_security_group.runner_sg.id]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

# -------------------------------------------------------------------
# DB credentials — random password, stored in Secrets Manager
# -------------------------------------------------------------------
resource "random_password" "db_password" {
  length           = 20
  special          = true
  override_special = "!#$%&*()-_=+[]{}"
}

resource "aws_secretsmanager_secret" "db_creds" {
  name = "mysql-rds-credentials"
}

resource "aws_secretsmanager_secret_version" "db_creds" {
  secret_id = aws_secretsmanager_secret.db_creds.id
  secret_string = jsonencode({
    username = var.db_username
    password = random_password.db_password.result
    engine   = "mysql"
    host     = aws_db_instance.mysql_rds.address
    port     = 3306
    dbname   = "dev"
  })
}

# -------------------------------------------------------------------
# RDS — private, in the VPC's private subnets, no public access
# -------------------------------------------------------------------
resource "aws_db_instance" "mysql_rds" {
  identifier             = "my-mysql-db"
  engine                 = "mysql"
  instance_class         = "db.t3.micro"
  username               = var.db_username
  password               = random_password.db_password.result
  db_name                = "dev"
  allocated_storage      = 20
  skip_final_snapshot    = true
  publicly_accessible    = false
  db_subnet_group_name   = aws_db_subnet_group.rds.name
  vpc_security_group_ids = [aws_security_group.rds_sg.id]
}

# -------------------------------------------------------------------
# EC2 runner — same VPC as RDS, in the public subnet so we can SSH to it
# -------------------------------------------------------------------
data "aws_ami" "amazon_linux_2" {
  most_recent = true
  owners      = ["amazon"]
  filter {
    name   = "name"
    values = ["amzn2-ami-hvm-*-x86_64-gp2"]
  }
}

resource "aws_instance" "sql_runner" {
  ami                         = data.aws_ami.amazon_linux_2.id
  instance_type               = "t2.micro"
  key_name                    = aws_key_pair.runner_key.key_name
  subnet_id                   = aws_subnet.public.id
  vpc_security_group_ids      = [aws_security_group.runner_sg.id]
  associate_public_ip_address = true

  tags = { Name = "SQL Runner" }
}

# -------------------------------------------------------------------
# Run init.sql against the RDS instance from the runner box
# -------------------------------------------------------------------
resource "null_resource" "remote_sql_exec" {
  depends_on = [aws_db_instance.mysql_rds, aws_instance.sql_runner]

  connection {
    type        = "ssh"
    user        = "ec2-user"
    private_key = tls_private_key.runner_key.private_key_pem
    host        = aws_instance.sql_runner.public_ip
  }

  provisioner "file" {
    source      = "init.sql"
    destination = "/tmp/init.sql"
  }

  provisioner "remote-exec" {
    inline = [
      "sudo amazon-linux-extras enable mariadb10.5 -y",
      "sudo yum clean metadata",
      "sudo yum install -y mariadb",
      "mysql --version",
      # password passed via env var rather than -p flag so it doesn't show in `ps`
      "MYSQL_PWD='${random_password.db_password.result}' mysql -h ${aws_db_instance.mysql_rds.address} -u ${var.db_username} dev < /tmp/init.sql"
    ]
  }

  triggers = {
    sql_file = filemd5("init.sql")
  }
}

# -------------------------------------------------------------------
# Outputs
# -------------------------------------------------------------------
output "runner_public_ip" {
  value = aws_instance.sql_runner.public_ip
}

output "rds_endpoint" {
  value = aws_db_instance.mysql_rds.address
}

output "private_key_path" {
  value     = local_sensitive_file.private_key_pem.filename
  sensitive = true
}

output "secrets_manager_secret_arn" {
  value = aws_secretsmanager_secret.db_creds.arn
  
}
